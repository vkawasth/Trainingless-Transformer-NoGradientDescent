\@writefile{lof}{\contentsline {figure}{\numberline {46}{\ignorespaces Every critical point of the three potentials, grouped by fibre, with its leading holonomies drawn as dials (the arrow is the phase of $y_j$). A and B have one fibre each. C has two: eight points over the leximin fibre and two over $(1/40,1/40,9/40)$. In each case the number of critical points equals the normalised volume of the Newton polytope, which equals $\chi $, and that equality certifies the list complete. For C these are the critical points of the uncorrected $W$ (\cref  {rem:corrections}).}}{185}{figure.46}\protected@file@percent }
\newlabel{fig:tfobjects}{{46}{185}{Every critical point of the three potentials, grouped by fibre, with its leading holonomies drawn as dials (the arrow is the phase of $y_j$). A and B have one fibre each. C has two: eight points over the leximin fibre and two over $(1/40,1/40,9/40)$. In each case the number of critical points equals the normalised volume of the Newton polytope, which equals $\chi $, and that equality certifies the list complete. For C these are the critical points of the uncorrected $W$ (\cref {rem:corrections})}{figure.46}{}}
\newlabel{fig:tfobjects@cref}{{[figure][46][]46}{[1][184][]185}}
\newlabel{prop:scales}{{160}{186}{the conjecture in the three examples}{theorem.160}{}}
\newlabel{prop:scales@cref}{{[proposition][160][]160}{[1][184][]186}}
\@writefile{lof}{\contentsline {figure}{\numberline {47}{\ignorespaces The eigenvalues of $Q/W$ at the positive object, as $-\log |\mu |/L$ against $1/L$ for $L=50,\dots  ,1600$. The finite-$T$ offset is linear in $1/L$, so the curves run straight into their limits: $0$ once, then $h_j-h_1$ for each removed dimension. In B the second level removes two dimensions and two eigenvalues share the limit $1/60$. In C the fourth level, $13/80$, removes none and leaves no trace.}}{186}{figure.47}\protected@file@percent }
\newlabel{fig:tfspectrum}{{47}{186}{The eigenvalues of $Q/W$ at the positive object, as $-\log |\mu |/L$ against $1/L$ for $L=50,\dots ,1600$. The finite-$T$ offset is linear in $1/L$, so the curves run straight into their limits: $0$ once, then $h_j-h_1$ for each removed dimension. In B the second level removes two dimensions and two eigenvalues share the limit $1/60$. In C the fourth level, $13/80$, removes none and leaves no trace}{figure.47}{}}
\newlabel{fig:tfspectrum@cref}{{[figure][47][]47}{[1][186][]186}}
