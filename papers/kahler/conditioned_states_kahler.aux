\@writefile{lof}{\contentsline {figure}{\numberline {39}{\ignorespaces The decision maker's relation network after $1000$ episodes, one history per condition. Node colour is the lean walk (orange towards $X$, blue away). A grey edge is a co-revision walk above $2$. An arrow $u\to v$ is a lead-lag walk above $2$ ($v$ moves towards $u$ after $u$ revises). ``anchor $\pm $'' marks an anchor walk beyond $1.645$. Edges and labels here are descriptive and below the family-wise boundaries.}}{132}{figure.39}\protected@file@percent }
\newlabel{fig:memnet}{{39}{132}{The decision maker's relation network after $1000$ episodes, one history per condition. Node colour is the lean walk (orange towards $X$, blue away). A grey edge is a co-revision walk above $2$. An arrow $u\to v$ is a lead-lag walk above $2$ ($v$ moves towards $u$ after $u$ revises). ``anchor $\pm $'' marks an anchor walk beyond $1.645$. Edges and labels here are descriptive and below the family-wise boundaries}{figure.39}{}}
\newlabel{fig:memnet@cref}{{[figure][39][]39}{[1][130][]132}}
