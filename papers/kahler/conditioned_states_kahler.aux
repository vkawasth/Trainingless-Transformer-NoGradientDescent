\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces The selection theorem on a column-binding fibre. (a) Level~1 fixes cells $13$ and $23$ at $1/10$ and leaves a segment of candidates, whose endpoints are not candidates. Level~2 picks its midpoint. (b) Along the segment, the least remaining cell is largest at $x=3/20$. (c) At finite $T$ the selected point is offset by $\ln 2/(2L)$, because two cells pull against one. (d) The positive thimble along the segment shows both levels as $h$ grows.}}{29}{figure.7}\protected@file@percent }
\newlabel{fig:leximin}{{7}{29}{The selection theorem on a column-binding fibre. (a) Level~1 fixes cells $13$ and $23$ at $1/10$ and leaves a segment of candidates, whose endpoints are not candidates. Level~2 picks its midpoint. (b) Along the segment, the least remaining cell is largest at $x=3/20$. (c) At finite $T$ the selected point is offset by $\ln 2/(2L)$, because two cells pull against one. (d) The positive thimble along the segment shows both levels as $h$ grows}{figure.7}{}}
\newlabel{fig:leximin@cref}{{[figure][7][]7}{[1][28][]29}}
\citation{ChoOh2006}
