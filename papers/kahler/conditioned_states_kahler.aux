\@writefile{lof}{\contentsline {figure}{\numberline {48}{\ignorespaces Phases of the objects of \cref  {fig:tfobjects}. (a) Example A is $(\mathbb  {CP}^1)^3$, with one Bloch sphere for each binding column. The height is $P(\text  {row }2\mid \text  {column})$, which is $1/2$ at the leximin fibre, and the longitude is the holonomy, so the eight objects are the product basis $|{\pm }{\pm }{\pm }\rangle $. (b) B's six holonomies form a cyclic group of order $6$ (dials as in \cref  {fig:tfobjects}; each edge adds the generator). (c) C's eight holonomies over the leximin fibre form $\mathbb  Z/4\times \mathbb  Z/2$, and the two over the other fibre are $\pm (i,i,i)$, which differ by turning all three dials through $\pi $.}}{189}{figure.48}\protected@file@percent }
\newlabel{fig:bloch}{{48}{189}{Phases of the objects of \cref {fig:tfobjects}. (a) Example A is $(\mathbb {CP}^1)^3$, with one Bloch sphere for each binding column. The height is $P(\text {row }2\mid \text {column})$, which is $1/2$ at the leximin fibre, and the longitude is the holonomy, so the eight objects are the product basis $|{\pm }{\pm }{\pm }\rangle $. (b) B's six holonomies form a cyclic group of order $6$ (dials as in \cref {fig:tfobjects}; each edge adds the generator). (c) C's eight holonomies over the leximin fibre form $\mathbb Z/4\times \mathbb Z/2$, and the two over the other fibre are $\pm (i,i,i)$, which differ by turning all three dials through $\pi $}{figure.48}{}}
\newlabel{fig:bloch@cref}{{[figure][48][]48}{[1][188][]189}}
