\@writefile{lof}{\contentsline {figure}{\numberline {51}{\ignorespaces The tower: Study 26 at seven levels, with each signal keeping its colour: honest, coalition, the $\{M,R,Y\}$ history, the decision threshold and the twist. (1)~The tables as a hypergraph of contexts, and the holdout cycle with its twisted edge. (2)~Each table's reading of $P(M{=}1)$: coherent data lie on the diagonal, and the pooled $\{M,C\}$ table, carrying the other population, does not. (3)~A section of the fibre through the honest law, with the decision hyperplane, history B, and the truth projected. (4)~The cycle's correlations against the noncontextual polytope. (5)~The toric chart of the coupling of $M$ and light: its polygon, the log-linear grid and maximum entropy. (6)~The soft-min potential of the same coupling, with its critical points tending to the leximin coupling (\cref  {prop:selectorlink}(ii)), which sits $0.0006$ from the advisory threshold. (7)~A schematic braid of the revision history. Panels 1 and 7 are drawn, and the braid is not computed in Study 26. The others are computed from the study. Levels are representations of the same data, not identical objects; \cref  {fig:atlas} labels the maps between them.}}{197}{figure.51}\protected@file@percent }
\newlabel{fig:tower}{{51}{197}{The tower: Study 26 at seven levels, with each signal keeping its colour: honest, coalition, the $\{M,R,Y\}$ history, the decision threshold and the twist. (1)~The tables as a hypergraph of contexts, and the holdout cycle with its twisted edge. (2)~Each table's reading of $P(M{=}1)$: coherent data lie on the diagonal, and the pooled $\{M,C\}$ table, carrying the other population, does not. (3)~A section of the fibre through the honest law, with the decision hyperplane, history B, and the truth projected. (4)~The cycle's correlations against the noncontextual polytope. (5)~The toric chart of the coupling of $M$ and light: its polygon, the log-linear grid and maximum entropy. (6)~The soft-min potential of the same coupling, with its critical points tending to the leximin coupling (\cref {prop:selectorlink}(ii)), which sits $0.0006$ from the advisory threshold. (7)~A schematic braid of the revision history. Panels 1 and 7 are drawn, and the braid is not computed in Study 26. The others are computed from the study. Levels are representations of the same data, not identical objects; \cref {fig:atlas} labels the maps between them}{figure.51}{}}
\newlabel{fig:tower@cref}{{[figure][51][]51}{[1][196][]197}}
\@writefile{lof}{\contentsline {figure}{\numberline {52}{\ignorespaces Study 26 at five levels, from the toric chart of the fibre to a braid encoding of the revision order. One signal, a table on the foreign context $\{M,R,Y\}$ that was refitted and later retracted, is followed through every level in purple. The boxes on the right label each map with its operation, what it keeps and what it loses. Object types are kept apart: observed tables, inferred laws (hollow), selected states (filled) and the constructed braid. Panels 1, 2, the right of 3 and 4 are computed from the study. The left of panel 3 is drawn from the design. The variable-changing row of panel 4 is the example of \cref  {prop:kerneltransport}. Panel 5 is built by the stated encoding rule from the study's actual refit order.}}{198}{figure.52}\protected@file@percent }
\newlabel{fig:atlas}{{52}{198}{Study 26 at five levels, from the toric chart of the fibre to a braid encoding of the revision order. One signal, a table on the foreign context $\{M,R,Y\}$ that was refitted and later retracted, is followed through every level in purple. The boxes on the right label each map with its operation, what it keeps and what it loses. Object types are kept apart: observed tables, inferred laws (hollow), selected states (filled) and the constructed braid. Panels 1, 2, the right of 3 and 4 are computed from the study. The left of panel 3 is drawn from the design. The variable-changing row of panel 4 is the example of \cref {prop:kerneltransport}. Panel 5 is built by the stated encoding rule from the study's actual refit order}{figure.52}{}}
\newlabel{fig:atlas@cref}{{[figure][52][]52}{[1][196][]198}}
\citation{Seidel2008}
\citation{Smith2018}
