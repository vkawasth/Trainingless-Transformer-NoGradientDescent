CONFIG seed=99 corpus=real
LOG "Spectral E0 baseline"
EVAL n=8
LOG "PHASE 1: SADDLE EXIT"
SADDLE
TAU
LOG "PHASE 2: ADAPTIVE MF PUMP (stop on Phi=5 OR tau rising twice)"
TAU
SET_COUNTER 0 15
RESET_RISING tau
LABEL L0
JZ_COUNTER 0 L1
MFPUMP seed=0
TAU
BRANCH_GE phi 5.000000 L1
BRANCH_RISING2 tau L1
DEC_COUNTER 0
JMP L0
LABEL L1
LOG "PHASE 3: BASIN SETTLE (GEO-STOP inside) + tau-retry tail"
BASIN max=150
TAU_RETRY
LOG "SNAPPER POLYNOMIAL JUMP"
SNAPPER
BRANCH_GE val 0.014700 L3
LOG "REACHED FLOOR via snapper"
JMP L2
LABEL L3
LOG "PHASE 4: TOPOGATE"
TOPOGATE
LOG "PHASE 5: ALIGNMENT + LM + K0/JOINT (tau-branched)"
ALIGN_LM
BRANCH_GE tau 3.000000 L5
K0_SPLIT
JMP L4
LABEL L5
BRANCH_LT tau 5.000000 L6
JOINT_CE
JMP L4
LABEL L6
JOINT_CE
JMP L4
LABEL L4
JMP L2
LABEL L2
EVAL n=15
ASSERT_LT val 0.200000
LOG "geometry compiler complete"
HALT
