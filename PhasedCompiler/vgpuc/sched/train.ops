CONFIG seed=99 corpus=synthetic
LOG "baseline"
EVAL n=4
SET_COUNTER 0 5
LABEL L0
JZ_COUNTER 0 L1
TRAIN steps=20
EVAL n=4
TAU
MEM
DEC_COUNTER 0
JMP L0
LABEL L1
SET_COUNTER 1 10
LABEL L2
JZ_COUNTER 1 L3
BRANCH_LT val 2.000000 L3
TRAIN steps=25
EVAL n=4
DEC_COUNTER 1
JMP L2
LABEL L3
ASSERT_LT val 3.000000
LOG "done"
HALT
